
<mujoco model="PingPongRL">

  <!-- Load SO-ARM100 robot -->
  <include file="so_arm100.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.3 0.3 0.3"
               specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox"
             builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512"
             height="3072"/>

    <texture type="2d"
             name="groundplane"
             builtin="checker"
             mark="edge"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300"
             height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <worldbody>

    <!-- Lighting -->
    <light pos="0 0 1.5"
           dir="0 0 -1"
           directional="true"/>

    <!-- Floor -->
    <geom name="floor"
          size="0 0 0.05"
          type="plane"
          material="groundplane"
          solref="0.01 0.2"
          solimp="0.95 0.99 0.001"/>

    <!-- GREEN WALL -->
    <geom name="pingpong_wall"
          type="box"
          pos="0 0.7 0.3"
          size="0.5 0.02 0.3"
          rgba="0.2 0.8 0.3 1"
          solref="0.01 0.2"
          solimp="0.95 0.99 0.001"/>

    <!-- ORANGE PING PONG BALL -->
    <body name="pingpong_ball"
          pos="0.437 0.35 0.04">

      <freejoint name="ball_joint"/>

      <geom name="ball_geom"
            type="sphere"
            size="0.02"
            mass="0.0027"
            rgba="1 0.5 0 1"
            solref="0.01 0.2"
            solimp="0.95 0.99 0.001"/>

    </body>

  </worldbody>

</mujoco>
